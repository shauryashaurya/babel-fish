{
  "name": "babel-fish",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:data": "node scripts/verify-data.mjs",
    "test:exports": "node scripts/test-exports.mjs",
    "test:framework": "node scripts/test-framework.mjs",
    "test:security": "node --test scripts/test-security.mjs",
    "audit:security": "npm audit --audit-level=low",
    "postinstall": "node scripts/patch-svelte-merge.mjs",
    "test:rag": "node scripts/test-rag-math.mts"
  },
  "dependencies": {
    "katex": "0.19.1",
    "svelte": "^5.57.3"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.6",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "overrides": {
    "@sveltejs/vite-plugin-svelte": {
      "deepmerge": "npm:@fastify/deepmerge@3.2.4"
    }
  }
}
